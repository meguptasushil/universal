# /etc/systemd/system/universal-relay.service (deploy/install.sh relay writes this for you)
# Optional settings go in /etc/universal/relay.env: UNIVERSAL_DOMAIN, UNIVERSAL_TOKENS,
# UNIVERSAL_EMAIL, UNIVERSAL_TCP_PORTS. Without a domain the relay uses <ip>.sslip.io,
# and without a token it generates one in /var/lib/universal/relay-token.
[Unit]
Description=Universal relay
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/universal/relay.env
ExecStart=/usr/local/bin/universal relay --state /var/lib/universal
User=universal
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/universal
PrivateTmp=true

[Install]
WantedBy=multi-user.target
